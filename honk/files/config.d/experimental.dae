# using for enable experimental features
# clash-api, cache-file

experimental {
    udp_nfqueue {
        enabled: true
    }
    clash_api {
        external_controller: '0.0.0.0:9090'
        external_ui: 'zashboard'
        secret: ''
        default_mode: 'Rule'
    }
    cache_file {
        enabled: true
        path: 'cache.db'
        cache_id: ''
        store_fakeip: false #in this time, this field will be ignored
    }
}
